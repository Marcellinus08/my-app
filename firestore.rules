rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isPairedFamily(tunaNetraUid) {
      let familyData = get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
      return isSignedIn() &&
        (
          (familyData.pairedUserUid is string &&
           familyData.pairedUserUid == tunaNetraUid) ||
          (familyData.pairedUserUids is list &&
           tunaNetraUid in familyData.pairedUserUids)
        );
    }
    
    // ========== OTP Collection (Production Ready) ==========
    // DEVELOPMENT: Allow anyone (less secure)
    // PRODUCTION: Use strict rules below
    
    match /otp_codes/{email} {
      // Allow creation for OTP sending
      allow create: if 
        request.resource.data.email == email &&
        request.resource.data.email is string &&
        request.resource.data.otp is string &&
        request.resource.data.email.size() > 5;
      
      // Allow read for verification only
      allow read: if true;
      
      // Allow update for verification or attempts increment
      allow update: if 
        request.resource.data.email == email &&
        resource.data.verified == false;
      
      // No delete - cleanup via Cloud Function scheduler
      allow delete: if false;
    }
    
    // ========== Users Collection (Production Ready) ==========
    match /users/{uid} {
      // Strict creation rules during registration
      allow create: if 
        request.resource.data.keys().hasAll(['email', 'username']) &&
        request.resource.data.email is string &&
        request.resource.data.username is string &&
        request.resource.data.createdAt is timestamp;
      
      // Authenticated users may read profiles for pairing/monitoring flows.
      allow read: if request.auth != null;
      
      // Pairing approval writes both the TunaNetra and Family documents.
      allow update: if request.auth != null;

      match /family_members/{familyUid} {
        allow read, write: if request.auth != null;
      }

      match /fcmTokens/{tokenId} {
        allow read: if request.auth != null && request.auth.uid == uid;

        allow create, update: if request.auth != null &&
          request.auth.uid == uid &&
          request.resource.data.userId == uid &&
          request.resource.data.userType == 'family' &&
          request.resource.data.token is string &&
          request.resource.data.token.size() > 0;

        allow delete: if request.auth != null && request.auth.uid == uid;
      }
      
      // No delete for safety
      allow delete: if false;
    }
    
    // ========== Pairing Codes - For TunaNetra & Family linking ==========
    match /pairing_codes/{code} {
      // Allow create for new pairing codes
      allow create: if request.resource.data.keys().hasAll(['userId', 'code', 'createdAt']);
      
      // Allow read to verify codes
      allow read: if true;
      
      // Allow update (limited)
      allow update: if 
        resource.data.status != 'paired' || 
        request.auth.uid == resource.data.userId;
      
      // No delete
      allow delete: if false;
    }

    // ========== Pairing Requests - Family asks, TunaNetra confirms ==========
    match /pairing_requests/{requestId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.familyUid ||
         request.auth.uid == resource.data.tunaNetraUid);

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.familyUid &&
        request.resource.data.keys().hasAll([
          'familyUid',
          'tunaNetraUid',
          'pairingCode',
          'status',
          'createdAt'
        ]) &&
        request.resource.data.status == 'pending';

      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.familyUid ||
         request.auth.uid == resource.data.tunaNetraUid);

      allow delete: if false;
    }

    match /live_tracking/{userId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == userId || isPairedFamily(userId));

      allow create: if isSignedIn() && request.auth.uid == userId;

      allow update: if isSignedIn() &&
        (
          request.auth.uid == userId ||
          (
            isPairedFamily(userId) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'isNavigating',
              'currentTripId',
              'destinationName',
              'connectionStatus',
              'updatedAt'
            ]) &&
            request.resource.data.isNavigating == false &&
            request.resource.data.currentTripId == null &&
            request.resource.data.destinationName == null &&
            request.resource.data.connectionStatus == 'offline'
          )
        );

      allow delete: if false;
    }

    match /sos_alerts/{sosId} {
      allow read: if isSignedIn() &&
        (
          request.auth.uid == resource.data.userId ||
          (
            resource.data.familyUids is list &&
            request.auth.uid in resource.data.familyUids
          )
        );

      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.userId &&
        request.resource.data.familyUids is list &&
        request.resource.data.familyUids.size() > 0 &&
        request.resource.data.status == 'active' &&
        request.resource.data.keys().hasAll([
          'userId',
          'userName',
          'familyUids',
          'status',
          'createdAt',
          'resolvedAt'
        ]);

      allow update: if isSignedIn() &&
        resource.data.familyUids is list &&
        request.auth.uid in resource.data.familyUids &&
        resource.data.status == 'active' &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.familyUids == resource.data.familyUids &&
        request.resource.data.status == 'resolved' &&
        (
          !('resolvedBy' in request.resource.data) ||
          request.resource.data.resolvedBy == request.auth.uid
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'resolvedAt',
          'resolvedBy'
        ]);

      allow delete: if false;
    }

    match /places/{placeId} {
      allow read: if isSignedIn() &&
        (
          resource.data.visibility == 'public' ||
          !('visibility' in resource.data) ||
          resource.data.ownerUid == request.auth.uid ||
          resource.data.createdBy == request.auth.uid ||
          (
            resource.data.ownerUid is string &&
            isPairedFamily(resource.data.ownerUid)
          )
        );

      allow create: if isSignedIn() &&
        (
          (
            request.resource.data.visibility == 'private' &&
            request.resource.data.ownerUid is string &&
            request.resource.data.createdBy == request.auth.uid &&
            (
              request.resource.data.ownerUid == request.auth.uid ||
              isPairedFamily(request.resource.data.ownerUid)
            )
          ) ||
          request.resource.data.visibility == 'public'
        );

      allow update, delete: if isSignedIn() &&
        resource.data.createdBy == request.auth.uid;
    }

    match /navigation_history/{tripId} {
      allow read: if isSignedIn() &&
        (
          request.auth.uid == resource.data.userId ||
          isPairedFamily(resource.data.userId)
        );

      allow create: if isSignedIn() &&
        request.auth.uid == request.resource.data.userId;

      allow update: if isSignedIn() &&
        (
          request.auth.uid == resource.data.userId ||
          (
            isPairedFamily(resource.data.userId) &&
            resource.data.status == 'ongoing' &&
            request.resource.data.userId == resource.data.userId &&
            request.resource.data.status == 'cancelled' &&
            request.resource.data.endReason == 'user_offline'
          )
        );

      allow delete: if false;

      match /events/{eventId} {
        allow read: if isSignedIn() &&
          (
            request.auth.uid ==
              get(/databases/$(database)/documents/navigation_history/$(tripId))
                .data.userId ||
            isPairedFamily(
              get(/databases/$(database)/documents/navigation_history/$(tripId))
                .data.userId
            )
          );

        allow create: if isSignedIn() &&
          (
            (
              request.resource.data.type == 'navigation_cancelled' &&
              (
                request.auth.uid ==
                  get(/databases/$(database)/documents/navigation_history/$(tripId))
                    .data.userId ||
                isPairedFamily(
                  get(/databases/$(database)/documents/navigation_history/$(tripId))
                    .data.userId
                )
              )
            ) ||
            (
              request.resource.data.type == 'sos_pressed' &&
              request.auth.uid ==
                get(/databases/$(database)/documents/navigation_history/$(tripId))
                  .data.userId
            )
          );

        allow update, delete: if false;
      }

      match /route_points/{pointId} {
        allow read: if isSignedIn() &&
          (
            request.auth.uid ==
              get(/databases/$(database)/documents/navigation_history/$(tripId))
                .data.userId ||
            isPairedFamily(
              get(/databases/$(database)/documents/navigation_history/$(tripId))
                .data.userId
            )
          );

        allow create, update: if isSignedIn() &&
          request.auth.uid ==
            get(/databases/$(database)/documents/navigation_history/$(tripId))
              .data.userId;

        allow delete: if false;
      }
    }
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
